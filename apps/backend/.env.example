PORT=3000
NODE_ENV=development
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MiniWorldRS
DB_USER=isi_user_database
DB_PASSWORD=isi_password_database
DB_ENCRYPT=false
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=30m
# Ganti dengan origin produksi yang sebenarnya (tanpa trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://bidan.example.id,https://rs.example.id
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
DEFAULT_UNIT_BIDAN_ID=00000000-0000-0000-0000-000000000000

# Brevo SMTP relay (jangan commit kredensial asli).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=isi_user_smtp_brevo
SMTP_PASS=isi_smtp_key_brevo
# Alamat pengirim yang sudah diverifikasi di Brevo.
SENDER_EMAIL=nama@domain-terverifikasi.id
